{
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "web-share=*"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/share/:path*", "destination": "https://genetic-breeds-backend.onrender.com/share/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
